# Staging environment variables (names must start with VITE_)

## Common API base path (with CORS this must be a full URL)
VITE_BASE_API = 'http://localhost:18891'

## Router mode: hash or html5
VITE_ROUTER_HISTORY = 'hash'

## Public path (the site prefix; e.g. when deploying under https://un-pany.github.io/v3-admin-vite/ set it to /v3-admin-vite/)
VITE_PUBLIC_PATH = '/platform/'
