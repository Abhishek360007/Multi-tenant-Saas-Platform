# Settings shared by every environment (names must start with VITE_)

## Site title
VITE_APP_TITLE = "TenantHub Admin"

## Address of the tenant portal, used for the tenant sign-in links. Either a full URL
## (https://portal.example.com/) or a domain that gets the tenant ID as a subdomain (.example.com)
VITE_TENANT_LINK = "tenanthub.example.com:8555/tenant/"
