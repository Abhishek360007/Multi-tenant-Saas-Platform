# Development environment variables (names must start with VITE_)

## Common API base path (with a reverse proxy only the path is needed)
VITE_BASE_API = 'http://127.0.0.1:18891'

## Router mode: hash or html5
VITE_ROUTER_HISTORY = 'hash'

## Development base path (usually '/' or './')
VITE_PUBLIC_PATH = '/platform/'
