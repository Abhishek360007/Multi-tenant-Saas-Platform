# Copy to .env and change every value before deploying.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=tenanthub_master
MYSQL_USER=tenanthub
MYSQL_PASSWORD=change-me-user
REDIS_PASSWORD=change-me-redis
# Container timezone. The server stores and returns times in UTC and the web UIs convert them to local time.
TZ=UTC

# Initial password for the platform admin (tenant "master", user "admin").
# Leave empty to use the seeded default, which must be changed at first sign-in.
TENANTHUB_BOOTSTRAP_ADMIN_PASSWORD=
