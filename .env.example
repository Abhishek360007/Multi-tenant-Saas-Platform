# Copy to .env and change every value before deploying.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=tenanthub_master
MYSQL_USER=tenanthub
MYSQL_PASSWORD=change-me-user
REDIS_PASSWORD=change-me-redis
# Container timezone. The app's Jackson config (application.yml) uses GMT+8; change both together.
TZ=Asia/Shanghai
