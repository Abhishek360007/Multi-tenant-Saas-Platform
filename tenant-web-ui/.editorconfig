# Configuration docs:https://editorconfig.org/

# Tell EditorConfig this is the root file
root = true

# Applies to all files
[*]
## Character set
charset = utf-8
## Indent style space | tab, recommended space
indent_style = space
## Indent size (if changed, also update prettier.config.js and .vscode -> settings.json)
indent_size = 2
## Line ending lf | cr | crlf, usually lf
end_of_line = lf
## Insert a final newline
insert_final_newline = true
## Trim trailing whitespace
trim_trailing_whitespace = true

# Applies to .md files
[*.md]
insert_final_newline = false
trim_trailing_whitespace = false
