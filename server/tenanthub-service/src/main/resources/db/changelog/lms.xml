<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">


    <!-- [ Log ] Operation log -->
    <changeSet context="tenant" author="WangChenChen (generated)" id="1699414162182-1">
        <createTable remarks="[ Log ] Operation log" tableName="lms_oper_log">
            <column name="id" remarks="ID" type="VARCHAR(50)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="title" remarks="Title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" remarks="Description" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="service_name" remarks="Service name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" remarks="User ID" type="BIGINT"/>
            <column name="method" remarks="Method" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="method_args" remarks="Method arguments" type="TEXT"/>
            <column name="request_method" remarks="Request method" type="VARCHAR(255)"/>
            <column name="request_url" remarks="Request URL" type="VARCHAR(255)"/>
            <column name="request_ip" remarks="Request IP" type="VARCHAR(255)"/>
            <column name="address" remarks="Request URL" type="VARCHAR(255)"/>
            <column name="response_result" remarks="Response" type="TEXT"/>
            <column name="status" remarks="Status" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="error_log" remarks="Error log" type="TEXT"/>
            <column name="time_cost" remarks="Duration (ms)" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="create_time" remarks="Created at" type="datetime">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>



    <!-- [ Log ] Login log -->
    <changeSet context="tenant" author="WangChenChen (generated)" id="1699414165075-1">
        <createTable remarks="[ Log ] Login log" tableName="lms_login_log">
            <column name="id" remarks="ID" type="VARCHAR(50)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="grant_type" remarks="Grant type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" remarks="User ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="nickname" remarks="User nickname" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="username" remarks="Username" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="avatar" remarks="Avatar" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="request_url" remarks="Request URL" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="request_ip" remarks="Request IP" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="address" remarks="Request URL" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="os_name" remarks="Operating system" type="VARCHAR(255)"/>
            <column name="browser" remarks="Browser" type="VARCHAR(255)"/>
            <column name="create_time" remarks="Created at" type="datetime">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>


</databaseChangeLog>
