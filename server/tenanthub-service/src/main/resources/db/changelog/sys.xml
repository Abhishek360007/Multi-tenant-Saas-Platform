                <constraints nullable="false"/>
            </column>
            <column name="email" remarks="Tenant email" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="linkman" remarks="Contact name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="contact_number" remarks="Contact number" type="VARCHAR(50)">
                <constraints nullable="false"/>
