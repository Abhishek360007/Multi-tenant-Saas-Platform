    <!-- India administrative areas: state -> district -> sub-district (LGD codes) -->
    <changeSet context="platform" author="Abhishek Raj" id="tenanthub-20261113-3">
        <createTable remarks="India administrative areas (LGD)" tableName="india_area">
            <column name="area_code" remarks="Unique code: state*1e9 + district*1e5 + subdistrict (LGD codes)" type="BIGINT UNSIGNED">
                <constraints nullable="false" primaryKey="true" unique="true"/>
            </column>
            <column name="level" remarks="1 = state/UT, 2 = district, 3 = sub-district" type="TINYINT(3) UNSIGNED">
                <constraints nullable="false"/>
            </column>
            <column defaultValueNumeric="0" name="parent_code" remarks="area_code of the parent (0 for states/UTs)" type="BIGINT UNSIGNED">
                <constraints nullable="false"/>
            </column>
            <column name="lgd_code" remarks="Local Government Directory code at this level" type="INT UNSIGNED">
                <constraints nullable="false"/>
            </column>
            <column defaultValue="" name="name" remarks="Name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column defaultValue="" name="merger_name" remarks="Full path, e.g. Karnataka-Bengaluru Urban-Bengaluru North" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column defaultValue="" name="type" remarks="State or UT (level 1 only)" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="india_area" indexName="idx_india_area_parent">
            <column name="parent_code"/>
        </createIndex>
    </changeSet>


