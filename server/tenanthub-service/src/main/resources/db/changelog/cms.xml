<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">


    <!-- [ Core ] Project table -->
    <changeSet context="tenant" author="WangChenChen (generated)" id="1699414175082-1">
        <createTable remarks="[ Project ] Project table" tableName="cms_project">
            <column autoIncrement="true" name="project_id" remarks="Project ID" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="project_name" remarks="Project name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="linkman" remarks="Contact name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="contact_number" remarks="Contact number" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="area_code" remarks="Area" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="address" remarks="Address, e.g. 12 MG Road, Block A" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="sort" remarks="Sort order" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="password" remarks="Project password, required for dangerous operations" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column defaultValueNumeric="1" name="status" remarks="Status [0 = disabled, 1 = normal, 2 = locked]" type="TINYINT(4)">
                <constraints nullable="false"/>
            </column>
            <column name="dept_id" remarks="Department ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="create_time" remarks="Created at" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="create_user" remarks="Created by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="last_update_time" remarks="Last updated at" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="last_update_user" remarks="Last updated by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addAutoIncrement tableName="cms_project" columnDataType="BIGINT" columnName="project_id" startWith="10001"/>
    </changeSet>


    <!-- [ Project ] Device table -->
    <changeSet context="tenant" author="WangChenChen (generated)" id="1699414177577-1">
        <createTable remarks="[ Project ] Device table" tableName="cms_device">
            <column name="device_id" remarks="Device ID" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="device_name" remarks="Device name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column defaultValueNumeric="1" name="status" remarks="Status [0 = disabled, 1 = normal, 2 = locked]" type="TINYINT(4)">
                <constraints nullable="false"/>
            </column>
            <column name="project_id" remarks="Project ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="create_time" remarks="Created at" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="create_user" remarks="Created by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="last_update_time" remarks="Last updated at" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="last_update_user" remarks="Last updated by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>


    <!-- PIN code on project addresses -->
    <changeSet context="tenant" author="Abhishek Raj" id="tenanthub-20261113-6">
        <addColumn tableName="cms_project">
            <column name="pin_code" remarks="6-digit PIN code" type="VARCHAR(6)" defaultValue="">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>


</databaseChangeLog>
