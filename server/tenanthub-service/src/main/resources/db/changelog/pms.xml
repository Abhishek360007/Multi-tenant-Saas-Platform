<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">


    <!-- [ Permissions ] Role table -->
    <changeSet context="tenant" author="WangChenChen (generated)" id="1699414131175-1">
        <createTable remarks="[ Permissions ] Role table" tableName="pms_role">
            <column autoIncrement="true" name="role_id" remarks="Role id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="role_name" remarks="Role name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="sort" remarks="Sort order" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="data_scope" type="tinyint" defaultValue="4"
                    remarks="Data scope (1: all data, 2: custom, 3: own department only, 4: own department and below)">
                <constraints nullable="false"/>
            </column>
            <column name="description" remarks="Department description" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="create_time" remarks="Created at" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="create_user" remarks="Created by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="last_update_time" remarks="Last updated at" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="last_update_user" remarks="Last updated by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addAutoIncrement tableName="pms_role" columnDataType="BIGINT" columnName="role_id" startWith="10001"/>
    </changeSet>


    <!-- [ Permissions ] Role-menu table -->
    <changeSet context="tenant" author="WangChenChen (generated)" id="1699414131175-2">
        <createTable remarks="[ Permissions ] Role-menu table" tableName="pms_role_menu">
            <column name="role_id" remarks="Role ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="menu_id" remarks="Menu ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>


    <!-- [ Permissions ] Role-department table -->
    <changeSet context="tenant" author="WangChenChen (generated)" id="1699414131175-3">
        <createTable remarks="[ Permissions ] Role-department table" tableName="pms_role_dept">
            <column name="role_id" remarks="Role ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="dept_id" remarks="Department ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!--[ Permissions ] Department table-->
    <changeSet context="tenant" author="WangChenChen (generated)" id="1699414139574-1">
        <createTable remarks="[ Permissions ] Department table" tableName="pms_dept">
            <column autoIncrement="true" name="dept_id" remarks="Department ID" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column defaultValueNumeric="0" name="parent_id" remarks="Parent key" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="dept_name" remarks="Department name" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="leader" remarks="Department leader name" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="leader_mobile" remarks="Leader mobile number" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="sort" remarks="Sort order" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="description" remarks="Department description" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="ancestors" remarks="Ancestors" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="create_time" remarks="Created at" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="create_user" remarks="Created by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="last_update_time" remarks="Last updated at" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="last_update_user" remarks="Last updated by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addAutoIncrement tableName="pms_dept" columnDataType="BIGINT" columnName="dept_id" startWith="10001"/>
    </changeSet>


    <!-- [ Permissions ] Department-menu table -->
    <changeSet context="tenant" author="WangChenChen (generated)" id="1699414139574-2">
        <createTable remarks="[ Permissions ] Department-menu table" tableName="pms_dept_menu">
            <column name="dept_id" remarks="Department ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="menu_id" remarks="Menu ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>


    <!-- [ Permissions ] User table -->
    <changeSet context="tenant" author="WangChenChen (generated)" id="1699414146178-1">
        <createTable remarks="[ Permissions ] User table" tableName="pms_user">
            <column name="user_id" remarks="User ID" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="avatar" remarks="Avatar" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="username" remarks="Account" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="mobile" remarks="Mobile number" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="email" remarks="Email" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="nickname" remarks="User name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="password" remarks="Password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column defaultValueNumeric="0" name="gender" remarks="Gender [0 = female, 1 = male, 2 = unknown]" type="TINYINT(4)">
                <constraints nullable="false"/>
            </column>
            <column name="dept_id" remarks="Department ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column defaultValueNumeric="1" name="status" remarks="Status [0 = disabled, 1 = normal, 2 = locked]" type="TINYINT(4)">
                <constraints nullable="false"/>
            </column>
            <column defaultValueNumeric="0" name="admin_flag" remarks="0. regular user, 1 = admin" type="TINYINT(4)">
                <constraints nullable="false"/>
            </column>
            <column name="expired" remarks="Expiry time; empty means the default" type="datetime"/>
            <column name="create_time" remarks="Created at" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="create_user" remarks="Created by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="last_update_time" remarks="Last updated at" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="last_update_user" remarks="Last updated by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>


    <!-- [ Permissions ] User-role table -->
    <changeSet context="tenant" author="WangChenChen (generated)" id="1699414146178-2">
        <createTable remarks="[ Permissions ] User-role table" tableName="pms_user_role">
            <column name="user_id" remarks="User ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="role_id" remarks="Role ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>


    <!-- [ Permissions ] User social login -->
    <changeSet context="tenant" author="WangChenChen (generated)" id="1699414146178-3">
        <createTable remarks="[ Permissions ] User social login" tableName="pms_user_social">
            <column autoIncrement="true" name="social_id" remarks="User social ID" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="user_id" remarks="Unique user ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column defaultValue="" name="open_id" remarks="Social account is unique ID" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="social_type" remarks="we_chat. WeChat  tencent_qq. Tencent QQ" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="create_time" remarks="Created at" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="create_user" remarks="Created by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="last_update_time" remarks="Last updated at" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="last_update_user" remarks="Last updated by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>


    <!-- Users whose password was set by someone else must change it at next login -->
    <changeSet context="tenant" author="Abhishek Raj" id="tenanthub-20261113-1">
        <addColumn tableName="pms_user">
            <column name="password_change_required" type="TINYINT" defaultValueNumeric="0" remarks="1 = must change password at next login">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>


</databaseChangeLog>
