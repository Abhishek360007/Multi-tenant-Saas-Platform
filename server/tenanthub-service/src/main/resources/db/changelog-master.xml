<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <include file="db/changelog/sys.xml"/>

    <include file="db/changelog/lms.xml"/>

    <include file="db/changelog/pms.xml"/>

    <include file="db/changelog/cms.xml"/>

    <!-- Seed tenants and permission templates -->
    <changeSet context="platform" author="WangChenChen (generated)" id="1699414472275-10">
        <sqlFile path="db/changelog/sql/tenant_init.sql"/>
    </changeSet>

    <!-- Seed users, roles and departments, -->
    <changeSet context="platform" author="WangChenChen (generated)" id="1699414472275-20">
        <sqlFile path="db/changelog/sql/pms_init.sql"/>
    </changeSet>

    <!-- Seed the default projects -->
    <changeSet context="platform" author="WangChenChen (generated)" id="1699414472275-30">
        <sqlFile path="db/changelog/sql/cms_init.sql"/>
    </changeSet>

    <!-- India administrative areas (generated from LGD by scripts/india-area/generate.mjs) -->
    <changeSet context="platform" author="Abhishek Raj" id="tenanthub-20261113-4">
        <sqlFile path="db/changelog/sql/india_area.sql"/>
    </changeSet>

    <!-- Seed global settings-->
    <changeSet context="platform" author="WangChenChen (generated)" id="1699414472275-50">
        <sqlFile path="db/changelog/sql/sys_config.sql"/>
    </changeSet>

    <!-- Seed dictionary types-->
    <changeSet context="platform" author="WangChenChen (generated)" id="1699414472275-60">
        <sqlFile path="db/changelog/sql/sys_dict_type.sql"/>
    </changeSet>

    <!-- Seed dictionary data-->
    <changeSet context="platform" author="WangChenChen (generated)" id="1699414472275-70">
        <sqlFile path="db/changelog/sql/sys_dict_data.sql"/>
    </changeSet>

    <!-- Seed menu permissions -->
    <changeSet context="platform" author="WangChenChen (generated)" id="1699414472275-80">
        <sqlFile path="db/changelog/sql/sys_menu.sql"/>
    </changeSet>

    <!-- Seeded users start with well-known passwords: force a change at first login -->
    <changeSet context="platform" author="Abhishek Raj" id="tenanthub-20261113-2">
        <update tableName="pms_user">
            <column name="password_change_required" valueNumeric="1"/>
            <where>user_id IN (19980817, 6569516164032, 6569516878992)</where>
        </update>
    </changeSet>

    <!-- PIN code for the seeded tenant and projects (Bengaluru North) -->
    <changeSet context="platform" author="Abhishek Raj" id="tenanthub-20261113-7">
        <update tableName="sys_tenant">
            <column name="pin_code" value="560001"/>
            <where>tenant_id = 'master'</where>
        </update>
        <update tableName="cms_project">
            <column name="pin_code" value="560001"/>
            <where>project_id IN (10001, 10002, 10003)</where>
        </update>
    </changeSet>

    <!-- Indian public holidays (shared by all tenants) -->
    <changeSet context="platform" author="Abhishek Raj" id="tenanthub-20261113-8">
        <createTable remarks="Indian public holidays" tableName="sys_holiday">
            <column name="holiday_date" remarks="Holiday date" type="DATE">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="name" remarks="Holiday name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="category" remarks="gazetted or restricted" type="VARCHAR(20)" defaultValue="gazetted">
                <constraints nullable="false"/>
            </column>
            <column name="source" remarks="Source of the date" type="VARCHAR(100)" defaultValue="">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet context="platform" author="Abhishek Raj" id="tenanthub-20261113-9">
        <sqlFile path="db/changelog/sql/india_holidays.sql"/>
    </changeSet>

    <!-- Subscription plans (shared by all tenants) -->
    <changeSet context="platform" author="Abhishek Raj" id="tenanthub-20261113-10">
        <createTable remarks="Subscription plans, prices in paise before GST" tableName="sys_plan">
            <column name="plan_code" remarks="Plan code, e.g. free / basic / pro" type="VARCHAR(20)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="name" remarks="Plan name" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="description" remarks="Short description" type="VARCHAR(255)" defaultValue="">
                <constraints nullable="false"/>
            </column>
            <column name="monthly_price_paise" remarks="Monthly price in paise, before GST" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="yearly_price_paise" remarks="Yearly price in paise, before GST" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="max_users" remarks="Maximum users per tenant, -1 = unlimited" type="INT" defaultValueNumeric="-1">
                <constraints nullable="false"/>
            </column>
            <column name="max_projects" remarks="Maximum projects per tenant, -1 = unlimited" type="INT" defaultValueNumeric="-1">
                <constraints nullable="false"/>
            </column>
            <column name="sort" remarks="Sort order" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="status" remarks="1 = offered, 0 = hidden" type="TINYINT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addColumn tableName="sys_tenant">
            <column name="plan_code" remarks="Subscription plan" type="VARCHAR(20)" defaultValue="free">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet context="platform" author="Abhishek Raj" id="tenanthub-20261113-11">
        <sqlFile path="db/changelog/sql/billing_init.sql"/>
        <!-- The platform's own tenant is not billed -->
        <update tableName="sys_tenant">
            <column name="plan_code" value="pro"/>
            <where>tenant_id = 'master'</where>
        </update>
    </changeSet>


    <!-- Razorpay payments for subscriptions (shared by all tenants) -->
    <changeSet context="platform" author="Abhishek Raj" id="tenanthub-20261113-12">
        <createTable remarks="Subscription payments (Razorpay); amounts in paise" tableName="sys_payment">
            <column name="id" remarks="Payment ID" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="tenant_id" remarks="Tenant" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="plan_code" remarks="Plan bought" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="billing_cycle" remarks="MONTHLY or YEARLY" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="base_paise" remarks="Price before GST" type="BIGINT"><constraints nullable="false"/></column>
            <column name="cgst_paise" remarks="CGST" type="BIGINT"><constraints nullable="false"/></column>
            <column name="sgst_paise" remarks="SGST" type="BIGINT"><constraints nullable="false"/></column>
            <column name="igst_paise" remarks="IGST" type="BIGINT"><constraints nullable="false"/></column>
            <column name="total_paise" remarks="Amount charged" type="BIGINT"><constraints nullable="false"/></column>
            <column name="buyer_gstin" remarks="Tenant GSTIN at the time of purchase" type="VARCHAR(15)" defaultValue="">
                <constraints nullable="false"/>
            </column>
            <column name="place_of_supply" remarks="GST state code of the buyer" type="INT"><constraints nullable="false"/></column>
            <column name="razorpay_order_id" remarks="Razorpay order ID" type="VARCHAR(40)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="razorpay_payment_id" remarks="Razorpay payment ID" type="VARCHAR(40)" defaultValue="">
                <constraints nullable="false"/>
            </column>
            <column name="status" remarks="created, paid or failed" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="invoice_no" remarks="Invoice number, e.g. TH/2026-27/000001" type="VARCHAR(30)" defaultValue="">
                <constraints nullable="false"/>
            </column>
            <column name="period_start" remarks="Paid period start" type="datetime"/>
            <column name="period_end" remarks="Paid period end" type="datetime"/>
            <column name="created_at" remarks="Order created at" type="datetime"><constraints nullable="false"/></column>
            <column name="paid_at" remarks="Paid at" type="datetime"/>
        </createTable>
        <createIndex tableName="sys_payment" indexName="idx_sys_payment_tenant">
            <column name="tenant_id"/>
        </createIndex>
        <!-- When a paid plan lapses the tenant falls back to Free -->
        <addColumn tableName="sys_tenant">
            <column name="plan_expires" remarks="End of the paid plan period (null = no end)" type="datetime"/>
        </addColumn>
    </changeSet>


</databaseChangeLog>
